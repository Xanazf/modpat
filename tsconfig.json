{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2024"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": false,
    "verbatimModuleSyntax": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noImplicitAny": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "strictPropertyInitialization": false,

    "types": ["@webgpu/types", "node", "@duckdb/node-api"],

    "paths": {
      "@root/*": ["./*"],
      "@src/*": ["./src/*"],
      "@core/*": ["./src/core/*"],

      "@core_i/*": ["./src/core/integral/*"],
      "@i_skills/*": ["./src/core/integral/skills/*"],
      "@skill_cogi/*": ["./src/core/integral/skills/cognition/*"],
      "@skill_lang/*": ["./src/core/integral/skills/language/*"],
      "@skill_code/*": ["./src/core/integral/skills/code/*"],
      "@i_topology/*": ["./src/core/integral/topology/*"],

      "@core_s/*": ["./src/core/structural/*"],
      "@atomics/*": ["./src/core/structural/atomizers/*"],
      "@mutate/*": ["./src/core/structural/mutations/*"],
      "@props/*": ["./src/core/structural/properties/*"],
      "@workers/*": ["./src/core/structural/workers/*"],

      "@_lib/*": ["./src/_lib/*"],
      "@utils/*": ["./src/utils/*"],
      "@config": ["./src/config.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["./scripts/dev/scratchpad/*"]
}
